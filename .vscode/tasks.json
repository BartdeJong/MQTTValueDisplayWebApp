{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Svelte dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"exec",
				"--yes",
				"--package=node@22.23.4",
				"--",
				"npm",
				"run",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}\\mqttdisplayer"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}